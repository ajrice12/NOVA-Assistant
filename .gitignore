.env
.env.*
!.env.example
*.pem
*.key
*.token
credentials.json
credentials*.json
token.json
token*.json
secrets/
.secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
